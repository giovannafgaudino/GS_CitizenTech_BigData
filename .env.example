# copie para .env  (usado pelo docker compose)
# NAO coloque comentarios na mesma linha do valor.
AIRFLOW_UID=50000
# SP156_MODE: real = dados oficiais do SP156 (padrao) | sample = amostra SINTETICA, so para testes
SP156_MODE=real
# SP156_FONTE: auto = tenta a API do portal e, se falhar, usa os CSVs locais | api = so API | local = so CSVs locais
SP156_FONTE=auto
# Caminho (fallback) DENTRO do container (a pasta do projeto e montada em /opt/airflow/project). Coloque os CSVs em data/raw/
SP156_LOCAL_PATH=/opt/airflow/project/data/raw/arquivo-final-*-trim-26.csv
HASH_SALT=troque-este-salt
# CIDADEVIVA_API_URL: vazio = simulador de reportes (ver README)
CIDADEVIVA_API_URL=
