digraph ER {
  rankdir=LR; fontname="Helvetica"; nodesep=0.4; ranksep=0.9;
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [color="#64748B", dir=both, arrowhead=tee, arrowtail=crow, fontsize=8, fontname="Helvetica"];
  dim_data [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#BFDBFE"><b>dim_data</b></td></tr><tr><td align="left">PK data_id</td></tr><tr><td align="left">data · ano · mes · dia<br align="left"/>trimestre · dia_semana<br align="left"/>fim_de_semana<br align="left"/></td></tr></table>>];
  dim_sub [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#BFDBFE"><b>dim_subprefeitura</b></td></tr><tr><td align="left">PK subprefeitura_id</td></tr><tr><td align="left">nome_subprefeitura · zona<br align="left"/>centroide_lat · centroide_lon<br align="left"/></td></tr></table>>];
  dim_cat [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#BFDBFE"><b>dim_categoria</b></td></tr><tr><td align="left">PK categoria_id</td></tr><tr><td align="left">codigo · nome · descricao<br align="left"/>orgao_sugerido · prioridade_base<br align="left"/></td></tr></table>>];
  f_sp [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDE68A"><b>fato_solicitacao_sp156</b></td></tr><tr><td align="left">PK solicitacao_id<br align="left"/>FK data_id · FK subprefeitura_id<br align="left"/>FK categoria_id<br align="left"/>canal · servico · logradouro · cep<br align="left"/>latitude · longitude · status<br align="left"/>tempo_resposta_horas<br align="left"/>nivel_satisfacao · dt_ingestao<br align="left"/></td></tr></table>>];
  f_cv [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDE68A"><b>fato_reporte</b></td></tr><tr><td align="left">PK reporte_id<br align="left"/>FK data_id · FK subprefeitura_id<br align="left"/>FK categoria_id<br align="left"/>criado_em · canal · descricao<br align="left"/>possui_foto · latitude · longitude<br align="left"/>confianca_ia · requer_revisao_humana<br align="left"/>status · protocolo_prefeitura<br align="left"/>usuario_hash · dt_ingestao<br align="left"/></td></tr></table>>];
  m1 [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#BBF7D0"><b>mart_demanda_subprefeitura_mes</b></td></tr><tr><td align="left">ano_mes · subprefeitura_id · categoria_id<br align="left"/>qtd_solicitacoes · qtd_finalizadas<br align="left"/>taxa_resolucao<br align="left"/>tempo_medio_resposta_horas<br align="left"/>dt_ingestao<br align="left"/></td></tr></table>>];
  m2 [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#BBF7D0"><b>mart_triagem_ia</b></td></tr><tr><td align="left">data · categoria_id · qtd_reportes<br align="left"/>confianca_media<br align="left"/>qtd_revisao_humana<br align="left"/>pct_revisao_humana · dt_ingestao<br align="left"/></td></tr></table>>];
  f_sp -> dim_data; f_sp -> dim_sub; f_sp -> dim_cat;
  f_cv -> dim_data; f_cv -> dim_sub; f_cv -> dim_cat;
  m1 -> dim_sub [style=dashed]; m1 -> dim_cat [style=dashed]; m2 -> dim_cat [style=dashed];
}
